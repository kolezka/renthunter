# Local dev env. Copy to .env (gitignored, Bun auto-loads it).
# Prod/Coolify vars live in .env.production.example.

DATABASE_URL=postgres://renthunter:renthunter@localhost:5432/renthunter
APPRISE_URL=http://localhost:8000
PORT=3000

# All AI (scoring + embeddings) via LiteLLM (preferred; overrides DEEPSEEK_*/EMBED_*
# below). Models are also overridable at runtime in Settings → AI scoring.
LITELLM_API_KEY=
LITELLM_BASE_URL=https://<your-litellm-host>
SCORER_MODEL=deepseek/deepseek-chat
EMBED_MODEL=bge-m3

# Fallback if LITELLM_* is unset. Empty DEEPSEEK_API_KEY = scoring off (filters-only).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: route scraping through a browserless instance (JS render + its egress IP).
# `make up-browserless` starts a local one and wires these. Empty = direct fetch.
BROWSERLESS_URL=
BROWSERLESS_TOKEN=
