DATABASE_URL=postgres://wynajem:wynajem@localhost:5432/wynajem
APPRISE_URL=http://localhost:8000
PORT=3000

# Optional: route all scrape fetches through a self-hosted browserless instance
# (renders JS + uses its egress IP, bypassing IP blocks). Empty = direct fetch.
BROWSERLESS_URL=
BROWSERLESS_TOKEN=

# Production / Coolify environment for docker-compose.yml.
#
# Coolify: set these in the app resource's "Environment Variables" tab (the domain
# is assigned in the UI, not here). Manual host deploy: copy to .env.production
# (gitignored) and run:
#   docker compose --env-file .env.production up -d --build

# Required ---------------------------------------------------------

# Postgres password — compose fails fast if unset. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-strong-secret

# Optional ---------------------------------------------------------

# Route ALL AI (deepseek/* scoring + bge-m3 embeddings) through a self-hosted
# LiteLLM proxy with a single key. When set, these take precedence over the
# DEEPSEEK_*/EMBED_* vars below. The scorer/embedding model and endpoint can also
# be overridden at runtime in Settings → AI scoring (DB-backed).
LITELLM_API_KEY=
LITELLM_BASE_URL=https://<your-litellm-host>

# DeepSeek AI scoring. Leave empty to disable scoring (filters-only).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Browserless — route ALL scraping through a self-hosted browserless instance so the
# server's (possibly blocked) IP never hits the portals directly; browserless renders
# the page from its own egress IP and returns HTML. Point at its /content host; leave
# empty for direct fetch. TOKEN only if your instance requires ?token=.
#   BROWSERLESS_URL=http://<your-home-ip>:3000
BROWSERLESS_URL=
BROWSERLESS_TOKEN=
