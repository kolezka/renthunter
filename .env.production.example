# Production secrets/config for docker-compose.prod.yml.
# Copy to .env.production (gitignored) and fill in, then:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# REQUIRED — Postgres password (compose fails fast if unset).
POSTGRES_PASSWORD=change-me-to-a-strong-secret

# LiteLLM proxy (single key for scoring + embeddings; overrides DEEPSEEK_*/EMBED_*).
LITELLM_API_KEY=
LITELLM_BASE_URL=https://<your-litellm-host>

# Optional model/endpoint overrides (also editable in Settings → AI scoring).
SCORER_MODEL=deepseek/deepseek-chat
EMBED_MODEL=bge-m3

# Optional — DeepSeek AI scoring. Leave empty to disable scoring (filters-only).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional — host port the app is published on (front it with a reverse proxy/TLS).
APP_PORT=3000

# Optional — minutes between scheduled crawls (the scheduler sidecar POSTs /api/run).
CRAWL_INTERVAL_MIN=5
